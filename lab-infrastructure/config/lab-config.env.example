# k0rdent Training Lab Configuration
# Copy this file to lab-config.env and customize

# AWS Configuration
export AWS_REGION="us-east-1"

# SSH Access - IMPORTANT: Restrict to your IP ranges.
# Comma-separated CIDR list read by lab-provision.sh and passed to Terraform
# (allowed_ssh_cidrs). Resolution order in lab-provision.sh:
#   1. --ssh-cidr <cidr>  use exactly these
#   2. --ssh-cidr auto    use ONLY your current public IP
#   3. ALLOWED_SSH_CIDRS  this variable, when you export it yourself
#   4. (default)          your current public IP, ADDED to the list saved by the
#                         previous run (falls back to 0.0.0.0/0 with a warning
#                         only if your IP cannot be detected and nothing is saved)
#
# Setting this variable pins the allow-list: auto-detection is skipped entirely,
# so if your public IP later changes you will lose bastion SSH until you re-run
# with --ssh-cidr. Leave it unset unless you need fixed ranges (a cohort's
# office egress, a VPN block). The default union behaviour is lockout-proof.
#
# lab-provision.sh records the resolved list as LAB_LAST_SSH_CIDRS in
# lab-config.env, which it rewrites on every run. Do not set that yourself.
#export ALLOWED_SSH_CIDRS="YOUR_IP/32"

# Project Settings
export PROJECT_NAME="k0rdent-training"

# Default Software Versions
export K0S_VERSION="v1.35.4+k0s.0"
export METAL3_VERSION="v1.8.0"
export KUBEVIRT_VERSION="v1.6.3"
export GPU_OPERATOR_VERSION="v25.10.0"

# Cost Optimization
export USE_SPOT_INSTANCES="true"
export SPOT_MAX_PRICE=""  # Empty = on-demand price cap

# GPU Lab Settings
export GPU_ENGINEER_SLOTS="15"
export GPU_MODEL_STORAGE_SIZE="500"
